#!/bin/sh
# hv-open — the Herdr Open applet's launcher: the editor pane, else the app that had this extension.
set -u
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower"
PREVIOUS=$STATE/open-previous.tsv
LOG=$STATE/open.log
OPEN=${OPEN:-open}
HERE=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$STATE"
status=0
for path in "$@"; do
  if "$HERE/hv" "$path" >/dev/null 2>&1; then
    route=editor
  else
    case $path in
      *.*) ext=${path##*.} ;;
      *) ext= ;;
    esac
    app=
    if [ -n "$ext" ] && [ -f "$PREVIOUS" ]; then
      app=$(awk -F '\t' -v ext="$ext" '$1 == ext && $2 != "" { app = $2 } END { print app }' "$PREVIOUS")
    fi
    if [ -n "$app" ] && "$OPEN" -a "$app" "$path"; then
      route=previous:"$app"
    elif "$OPEN" -t "$path"; then
      route=text
    else
      route=failed
      status=1
    fi
  fi
  printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$path" "$route" >>"$LOG" 2>/dev/null || true
done
exit $status
